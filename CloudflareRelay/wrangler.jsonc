{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eng-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "durable_objects": {
    "bindings": [
      { "name": "CHANNELS", "class_name": "ChannelRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChannelRelay"] }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
